{
  "manifest_version": 3,
  "name": "Sugar Skip — skip the story, get the recipe",
  "short_name": "Sugar Skip",
  "version": "1.0.0",
  "description": "Pulls the recipe, ingredients, instructions, and rating off any baking page so you can skip the life story.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Get the recipe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:4747/*"]
}
